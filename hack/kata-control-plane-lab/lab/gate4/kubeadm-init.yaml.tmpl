# kubeadm config for the first replica of gate 4. run.sh fills the ${...} variables and puts
# the result at /kind/kubeadm.conf in the pod. Lines with a "#@" tag go away when their option
# is off:
#   #@etcdlisten   only with ETCD_LISTEN=all (etcd listens on all addresses)
#   #@etcdsan      only with ETCD_SAN_SKIP=1 (etcd does not compare a peer certificate with the source address)
#   #@etcdargs     the extraArgs line, only when one of the two is on
#   #@peerdns      only with ETCD_PEER_DNS=1 (the peer certificate gets the DNS name of the headless Service)
# The node address ${NODE_IP} is the LoadBalancer IP of the Service of the replica. The shared
# endpoint ${IP_API} is the LoadBalancer IP of the Service that selects all replicas.
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: ${K8S_VERSION}
clusterName: ${NS}
controlPlaneEndpoint: ${IP_API}:6443
etcd:
  local:
    dataDir: /var/lib/etcd
    # Only with ETCD_PEER_DNS=1: the DNS name of the headless Service of all replicas. kubeadm #@peerdns
    # puts it in the peer certificate of each replica, also of a replica that joins later. #@peerdns
    peerCertSANs: ["${PEER_NAME}"] #@peerdns
    extraArgs: #@etcdargs
      # A call from another replica comes through the Service, and kube-proxy of the host
      # cluster changes its destination to the pod IP. So etcd must listen on the pod IP too.
      # The pod IP changes with each new pod, so the listen address is 0.0.0.0.
      - {name: listen-client-urls, value: "https://0.0.0.0:2379"} #@etcdlisten
      - {name: listen-peer-urls, value: "https://0.0.0.0:2380"} #@etcdlisten
      # kube-proxy also changes the source address of the call. etcd compares the source
      # address of a peer with the names in its certificate, and that check then fails.
      - {name: peer-skip-client-san-verification, value: "true"} #@etcdsan
networking:
  # Not the ranges of the host cluster (10.96.0.0/16 and 10.244.0.0/16).
  serviceSubnet: 10.112.0.0/16
  podSubnet: 10.113.0.0/16
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
bootstrapTokens:
  - token: ${TOKEN}
    ttl: 2h
    usages: [signing, authentication]
    groups: ["system:bootstrappers:kubeadm:default-node-token"]
certificateKey: ${CERT_KEY}
localAPIEndpoint:
  advertiseAddress: ${NODE_IP}
  bindPort: 6443
nodeRegistration:
  # NVKE gives kubeadm the node name. The pod of a StatefulSet has the hostname ${NAME}-0.
  name: ${NAME}
  criSocket: unix:///run/containerd/containerd.sock
  # The image has all images. No pull from the guest.
  imagePullPolicy: Never
  kubeletExtraArgs:
    - {name: node-ip, value: "${NODE_IP}"}
# No kube-proxy and no CNI in the inner cluster, as in gate 1. The nodes stay NotReady.
skipPhases:
  - addon/kube-proxy
---
# The kubelet settings of kind (pkg/cluster/internal/kubeadm/config.go, lines 429 to 447).
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
cgroupRoot: /kubelet
imageGCHighThresholdPercent: 100
evictionHard:
  nodefs.available: "0%"
  nodefs.inodesFree: "0%"
  imagefs.available: "0%"
