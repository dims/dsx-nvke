{
  "name": "kata-cp1",
  "controlPlaneKubernetesVersion": "1.36.4",
  "cniPlugin": "ovn-kubernetes",
  "cniVersion": "2.4.2",
  "etcdEncrypted": false,
  "enableCPNodeRecycling": true,
  "controlPlaneEndpoint": "172.29.255.220:6443",
  "network": {
    "podCIDR": "10.113.0.0/16",
    "serviceCIDR": "10.112.0.0/16"
  },
  "controlPlaneConfig": {
    "desiredCount": 3,
    "maxSurge": 1,
    "systemReservedMemory": "512Mi",
    "infra": {
      "machineTemplate": {
  "apiVersion": "infrastructure.cluster.x-k8s.io/v1alpha1",
  "kind": "PodVMMachineTemplate",
  "spec": {
    "template": {
      "spec": {
        "image": "docker.io/library/nvke-node-podvm:bcc4376f-p11",
        "imagePullPolicy": "Never",
        "resources": {"cpu": "2", "memory": "6Gi"},
        "volumes": {
          "var": {"storageClassName": "podvm-local-block", "size": "20Gi"},
          "etcd": {"storageClassName": "podvm-local-block", "size": "8Gi"}
        }
      }
    }
  }
}
    }
  },
  "infra": {
    "cluster": {
      "apiVersion": "infrastructure.cluster.x-k8s.io/v1alpha1",
      "kind": "PodVMCluster",
      "metadata": {"name": "kata-cp1"},
      "spec": {
        "podNamespace": "d",
        "runtimeClassName": "kata-clh-runtime-rs-fix-direct-ovs",
        "networkAttachment": {"name": "nodenet", "namespace": "d"},
        "addressRange": {"cidr": "172.28.1.0/24", "prefixLength": 16},
        "failureDomainLabelKey": "topology.kubernetes.io/zone"
      }
    }
  },
  "nodePools": [
    {
      "name": "nico-workers",
      "nodeNamePrefix": "nw",
      "controlPlane": false,
      "desiredNodeCount": 2,
      "systemReservedMemory": "512Mi",
      "infra": {
        "machineTemplate": {
  "apiVersion": "infrastructure.cluster.x-k8s.io/v1alpha1",
  "kind": "NicoMachineTemplate",
  "metadata": {"name": "kata-cp1-nico-workers-template"},
  "spec": {
    "template": {
      "spec": {
        "siteID": "00000000-0000-0000-0000-000000000001",
        "vpcID": "00000000-0000-0000-0000-000000000002",
        "instanceTypeID": "00000000-0000-0000-0000-000000000005",
        "cloudInitInjectHostname": true,
        "ipxeScript": "#!ipxe\necho local-nico-worker\n",
        "sshKeyGroupIDs": ["00000000-0000-0000-0000-000000000004"],
        "interfaces": [{"subnetID": "00000000-0000-0000-0000-000000000003"}]
      }
    }
  }
},
        "preKubeadmCommands": [
          "n=0; until [ -S /run/systemd/private ] || [ $n -ge 600 ]; do n=$((n+1)); sleep 0.2; done; echo \"lab wait for systemd: $n steps of 0.2 s\"; [ -S /run/systemd/private ]",
          "mkdir -p /run/cluster-api",
          "echo success > /run/cluster-api/bootstrap-success.complete"
        ]
      }
    }
  ]
}
