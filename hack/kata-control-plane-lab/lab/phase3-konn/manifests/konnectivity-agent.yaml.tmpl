# Lab prototype (phase 3, Konnectivity): the agent, for the NEW cluster (not the host cluster).
# NVKE has no step for it in this prototype. The lab applies this file with the kubeconfig of
# the new cluster (run/konn.sh agent <run> apply).
# The form is the DaemonSet of Kubernetes 1.36.4 (cluster/gce/addons/konnectivity-agent), with
# these changes: the host network (the pod network of a worker does not reach the control plane
# in this test), workers only, each taint tolerated, --sync-forever, and the image by its tag
# with no pull.
#
# RBAC: the proxy server checks the token of an agent with a TokenReview. It uses admin.conf,
# which has that right. So the only object beside the DaemonSet is the service account. The
# upstream binding of the user system:konnectivity-server to system:auth-delegator is for a
# proxy server with a kubeconfig of its own, which this prototype does not have.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: konnectivity-agent
  namespace: kube-system
  labels:
    k8s-app: konnectivity-agent
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: konnectivity-agent
  namespace: kube-system
  labels:
    k8s-app: konnectivity-agent
spec:
  selector:
    matchLabels:
      k8s-app: konnectivity-agent
  updateStrategy:
    type: RollingUpdate
  template:
    metadata:
      labels:
        k8s-app: konnectivity-agent
    spec:
      priorityClassName: system-cluster-critical
      serviceAccountName: konnectivity-agent
      hostNetwork: true
      # The agent dials an address, not a name.
      dnsPolicy: Default
      # The agent runs on each node of the new cluster, the workers and the control plane nodes
      # (decision of 2026-11-28). The first form had a node affinity for the workers only.
      tolerations:
      - operator: Exists
      containers:
      - name: konnectivity-agent
        image: registry.k8s.io/kas-network-proxy/proxy-agent:v0.34.0
        imagePullPolicy: IfNotPresent
        command:
        - /proxy-agent
        args:
        - --logtostderr=true
        - --v=2
        - --ca-cert=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        - --proxy-server-host=${IP_API}
        - --proxy-server-port=${KONN_AGENT_PORT}
        - --service-account-token-path=/var/run/secrets/tokens/konnectivity-agent-token
        - --agent-identifiers=ipv4=$(HOST_IP)
        - --sync-forever=true
        - --sync-interval=5s
        - --sync-interval-cap=30s
        - --probe-interval=5s
        - --keepalive-time=60s
        - --health-server-port=8093
        - --admin-server-port=8094
        env:
        - name: HOST_IP
          valueFrom:
            fieldRef:
              fieldPath: status.hostIP
        resources:
          requests:
            cpu: 25m
            memory: 32Mi
        livenessProbe:
          httpGet:
            port: 8093
            path: /healthz
          initialDelaySeconds: 15
          timeoutSeconds: 15
        volumeMounts:
        - name: konnectivity-agent-token
          mountPath: /var/run/secrets/tokens
      volumes:
      - name: konnectivity-agent-token
        projected:
          sources:
          - serviceAccountToken:
              path: konnectivity-agent-token
              audience: system:konnectivity-server
