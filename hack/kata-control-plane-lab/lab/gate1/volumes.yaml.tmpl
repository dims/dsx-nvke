# Two raw block volumes for the node pod: one for /var, one for /var/lib/etcd.
# Each one is a loop device of the kind node, offered as a local PersistentVolume.
# The class name has no StorageClass object and no provisioner. The claimRef binds each
# volume to its claim, so the small claim cannot take the large volume.
# run.sh fills the ${...} variables.
apiVersion: v1
kind: PersistentVolume
metadata:
  name: ${NS}-${NAME}-var
spec:
  capacity: {storage: ${VAR_SIZE}}
  volumeMode: Block
  accessModes: [ReadWriteOnce]
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ${NS}-local-block
  claimRef: {namespace: ${NS}, name: ${NAME}-var}
  local: {path: ${VAR_LOOP}}
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - {key: kubernetes.io/hostname, operator: In, values: ["${KIND_NODE}"]}
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: ${NS}-${NAME}-etcd
spec:
  capacity: {storage: ${ETCD_SIZE}}
  volumeMode: Block
  accessModes: [ReadWriteOnce]
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ${NS}-local-block
  claimRef: {namespace: ${NS}, name: ${NAME}-etcd}
  local: {path: ${ETCD_LOOP}}
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - {key: kubernetes.io/hostname, operator: In, values: ["${KIND_NODE}"]}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${NAME}-var
  namespace: ${NS}
spec:
  volumeMode: Block
  accessModes: [ReadWriteOnce]
  storageClassName: ${NS}-local-block
  volumeName: ${NS}-${NAME}-var
  resources: {requests: {storage: ${VAR_SIZE}}}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${NAME}-etcd
  namespace: ${NS}
spec:
  volumeMode: Block
  accessModes: [ReadWriteOnce]
  storageClassName: ${NS}-local-block
  volumeName: ${NS}-${NAME}-etcd
  resources: {requests: {storage: ${ETCD_SIZE}}}
