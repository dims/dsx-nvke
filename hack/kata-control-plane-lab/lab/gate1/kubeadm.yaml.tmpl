# kubeadm config for the node pod of gate 1. It follows the config that kind writes to
# /kind/kubeadm.conf for Kubernetes v1.36. run.sh fills the ${...} variables and puts the
# result at /kind/kubeadm.conf in the pod. The kind entrypoint reads that path when the
# node address changes. The line with the tag "#@failswapoff" goes away with FAIL_SWAP_OFF=0.
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: ${K8S_VERSION}
clusterName: ${NS}
# Like kind: the node name. /etc/hosts of the pod gives it the pod IP of the day, so
# admin.conf and kubelet.conf stay valid when a new pod has a new IP.
controlPlaneEndpoint: ${NAME}:6443
apiServer:
  certSANs:
    - localhost
    - 127.0.0.1
    # The Service of the pod in the host cluster.
    - ${NAME}.${NS}.svc
    - ${NAME}.${NS}.svc.cluster.local
    - ${SVC_IP}
networking:
  # Not the ranges of the host cluster (10.96.0.0/16 and 10.244.0.0/16).
  serviceSubnet: 10.112.0.0/16
  podSubnet: 10.113.0.0/16
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: ${POD_IP}
  bindPort: 6443
nodeRegistration:
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - {name: node-ip, value: "${POD_IP}"}
# No kube-proxy. Gate 1 also installs no CNI, so the node stays NotReady.
skipPhases:
  - addon/kube-proxy
---
# The kubelet settings of kind (pkg/cluster/internal/kubeadm/config.go, lines 429 to 447).
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
cgroupRoot: /kubelet
failSwapOn: false #@failswapoff
imageGCHighThresholdPercent: 100
evictionHard:
  nodefs.available: "0%"
  nodefs.inodesFree: "0%"
  imagefs.available: "0%"
