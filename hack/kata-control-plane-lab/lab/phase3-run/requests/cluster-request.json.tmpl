{
  "name": "${CLUSTER_NAME}",
  "controlPlaneKubernetesVersion": "${K8S_VERSION}",
  "cniPlugin": "ovn-kubernetes",
  "cniVersion": "2.4.2",
  "etcdEncrypted": false,
  "enableCPNodeRecycling": true,
  "controlPlaneEndpoint": "${IP_API}:6443",
  "network": {
    "podCIDR": "${POD_CIDR}",
    "serviceCIDR": "${SERVICE_CIDR}"
  },
  "controlPlaneConfig": {
    "desiredCount": 3,
    "maxSurge": 1,
    "systemReservedMemory": "512Mi",
    "infra": {
      "machineTemplate": ${PODVM_MACHINE_TEMPLATE}
    }
  },
  "infra": {
    "cluster": {
      "apiVersion": "infrastructure.cluster.x-k8s.io/v1alpha1",
      "kind": "PodVMCluster",
      "metadata": {"name": "${CLUSTER_NAME}"},
      "spec": {
        "podNamespace": "${NS}",
        "runtimeClassName": "${RUNTIME_CLASS}",
        "networkAttachment": {"name": "nodenet", "namespace": "${NS}"},
        "addressRange": {"cidr": "${RANGE_CIDR}", "prefixLength": 16},
        "failureDomainLabelKey": "topology.kubernetes.io/zone"
      }
    }
  },
  "nodePools": [
    {
      "name": "${POOL_NAME}",
      "nodeNamePrefix": "${POOL_PREFIX}",
      "controlPlane": false,
      "desiredNodeCount": ${WORKER_COUNT},
      "systemReservedMemory": "512Mi",
      "infra": {
        "machineTemplate": ${NICO_MACHINE_TEMPLATE},
        "preKubeadmCommands": [
          "n=0; until [ -S /run/systemd/private ] || [ $n -ge 600 ]; do n=$((n+1)); sleep 0.2; done; echo \"lab wait for systemd: $n steps of 0.2 s\"; [ -S /run/systemd/private ]",
          "mkdir -p /run/cluster-api",
          "echo success > /run/cluster-api/bootstrap-success.complete"
        ]
      }
    }
  ]
}
