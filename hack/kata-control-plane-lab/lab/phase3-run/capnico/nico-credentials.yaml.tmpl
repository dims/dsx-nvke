# The Secret that CAPNICo reads for the NICo API: nico-credentials in capnico-system, with the
# keys endpoint, orgID, token and apiName. The name and the namespace are fixed in CAPNICo
# (cmd/main.go:32-33 and internal/nico/config.go:24-35 at v0.1.0). The form is the one of
# controller/deploy/capnico-e2e/nvke-base-config/20-nico-credentials.yaml.tmpl.
#
# This file has placeholders only. install-capnico.sh fills them:
#   NICO_ENDPOINT   http://<address of the simulator container on kata-bb>:18080
#   NICO_ORG_ID     the organization of the seed file of the simulator (default-seed.yaml:6)
#   NICO_TOKEN      a fake value. The simulator accepts each token that is not empty
#   NICO_API_NAME   forge
# Nothing here is a real credential. A real NICo site has a real token, which belongs in no file
# of the notes.
apiVersion: v1
kind: Secret
metadata:
  name: nico-credentials
  namespace: capnico-system
type: Opaque
stringData:
  endpoint: "${NICO_ENDPOINT}"
  orgID: "${NICO_ORG_ID}"
  token: "${NICO_TOKEN}"
  apiName: "${NICO_API_NAME}"
