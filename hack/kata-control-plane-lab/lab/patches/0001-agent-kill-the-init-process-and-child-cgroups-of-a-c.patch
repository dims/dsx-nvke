+        let dir = tempdir().unwrap();
+        let root = dir.path();
+        let cgroups = [
+            ("", ""),
+            ("init.scope", "1\n"),
+            ("system.slice", ""),
+            ("system.slice/containerd.service", "120\n121\n"),
+            // PID 0 is a process outside of the PID namespace of the reader.
+            ("kubelet.slice/kubelet-kubepods.slice/pod", "0\n300\n"),
