# Part 2 of the bootstrap data of the NVKE controller: the commands, and then
# the cloud-init status. The command of the controller restarts the node agent
# unit, which is ordered after multi-user.target. A unit that the target waits
# for cannot wait for that command, so this unit is ordered after the target,
# as cloud-final.service of cloud-init is.
[Unit]
Description=Run the commands of the NVKE bootstrap data
Requires=podvm-bootstrap.service
After=podvm-bootstrap.service multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/run/podvm/env
ExecStart=/usr/local/bin/podvm-bootstrap -phase commands

[Install]
WantedBy=multi-user.target
